# OpenWrt-ILP32 release configuration for mediatek/filogic (diffconfig seed for build-release.sh, which adds
# CONFIG_VERSION_NUMBER and CONFIG_VERSION_CODE). Applied with "make defconfig". A selection of well-known
# devices (OpenWrt forum), each with its own root file system; only the OpenWrt One is tested on hardware.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_openwrt_one=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_asus_tuf-ax4200=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5601-t0-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_asus_tuf-ax6000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_asus_zenwifi-bt8=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_asus_zenwifi-bt8-ubootmod=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_AARCH64_ABI_ILP32=y
# official OpenWrt LP64 packages in /opt/lp64 (there is no OpenWrt-ILP32 package repository)
CONFIG_PACKAGE_apk-lp64=y
# ucode (fw4, LuCI), lucihttp, ucode-mod-html and json-c compiled with clang (llvm-ilp32): fw4 reload 7%
# faster than with GCC on the OpenWrt One, the same memory
CONFIG_CLANG_ILP32=y
CONFIG_CLANG_ILP32_SELECTED=y
CONFIG_CLANG_ILP32_PACKAGES="ucode lucihttp ucode-mod-html json-c"
# a router image: the web interface, as in the official OpenWrt One images
CONFIG_PACKAGE_luci=y
# not the official OpenWrt build: own name and links, no official download or package repository
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt-ILP32"
CONFIG_VERSION_REPO="https://github.com/ilp32-a64/openwrt-ilp32/releases"
CONFIG_VERSION_HOME_URL="https://github.com/ilp32-a64/openwrt-ilp32"
CONFIG_VERSION_MANUFACTURER="ILP32-A64"
CONFIG_VERSION_MANUFACTURER_URL="https://github.com/ilp32-a64"
CONFIG_VERSION_BUG_URL="https://github.com/ilp32-a64/openwrt-ilp32/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/ilp32-a64/openwrt-ilp32"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/ilp32-a64/openwrt-ilp32/releases"
# no package feed, so no package signing keys in the image (neither the official one nor the build's)
# CONFIG_SIGNED_PACKAGES is not set
# the build user and host must not end up in the kernel version string
CONFIG_KERNEL_BUILD_USER="ilp32"
CONFIG_KERNEL_BUILD_DOMAIN="ilp32-a64"
