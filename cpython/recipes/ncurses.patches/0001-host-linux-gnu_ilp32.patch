Description: recognize the GNU/Linux host aarch64-linux-gnu_ilp32 (AArch64 ILP32)
 CF_XOPEN_SOURCE lists the GNU/Linux host_os spellings (linux*gnu,
 linux*gnux32, linux*gnueabihf, ...) that get _GNU_SOURCE; linux-gnu_ilp32
 is missing, so for the ILP32 triplet configure defines neither
 _GNU_SOURCE nor _XOPEN_SOURCE and the wide-character build fails
 (wcwidth undeclared). Add it next to linux*gnux32, also in configure.in's
 list for the xterm kbs default. Other hosts are unchanged; configure is
 regenerated by Debian's autoconf.sh.
Author: liviyifan <344781483+liviyifan@users.noreply.github.com>
Forwarded: no

--- a/aclocal.m4
+++ b/aclocal.m4
@@ -10334,7 +10334,7 @@
 	cf_xopen_source="-D_SGI_SOURCE"
 	cf_XOPEN_SOURCE=
 	;;
-(linux*gnu|linux*gnuabi64|linux*gnuabin32|linux*gnueabi|linux*gnueabihf|linux*gnux32|uclinux*|gnu*|mint*|k*bsd*-gnu|cygwin|msys|mingw*|linux*uclibc)
+(linux*gnu|linux*gnuabi64|linux*gnuabin32|linux*gnueabi|linux*gnueabihf|linux*gnux32|linux*gnu_ilp32|uclinux*|gnu*|mint*|k*bsd*-gnu|cygwin|msys|mingw*|linux*uclibc)
 	CF_GNU_SOURCE($cf_XOPEN_SOURCE)
 	;;
 linux*musl)
--- a/configure.in
+++ b/configure.in
@@ -659,7 +659,7 @@
 AC_SUBST(WHICH_XTERM)
 
 case $host_os in
-(linux*gnu|linux*gnuabi64|linux*gnuabin32|linux*gnueabi|linux*gnueabihf|linux*gnux32|uclinux*|gnu*|mint*|k*bsd*-gnu|cygwin|msys|mingw*|linux*uclibc|linux*musl)
+(linux*gnu|linux*gnuabi64|linux*gnuabin32|linux*gnueabi|linux*gnueabihf|linux*gnux32|linux*gnu_ilp32|uclinux*|gnu*|mint*|k*bsd*-gnu|cygwin|msys|mingw*|linux*uclibc|linux*musl)
 	want_xterm_kbs=DEL
 	;;
 (*)
